# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit real secrets.
# These are validated at boot by `lib/env.ts`; the app refuses to start if any is
# missing or invalid. Set the same vars per-environment in Vercel Project Settings.

# Access-gate stopgap (V0-4): shared household code that gates the preview/prod URL
# until Clerk household login lands (v1.5). Minimum 8 characters. This is a
# deterrent, NOT an authorization boundary — real authz lives in the DAL.
ACCESS_GATE_PASSWORD="change-me-to-a-long-random-code"

# Neon Postgres (V0-5). App runtime uses the POOLED string (PgBouncer). Migrations
# use the DIRECT/unpooled string via drizzle-kit — set DATABASE_URL_UNPOOLED when
# running `pnpm --filter @mat-plan/db db:migrate|db:seed` locally.
DATABASE_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# --- V1-14a hardening. ALL OPTIONAL — absent means the feature no-ops. ---
# Three environments legitimately run without these: local dev, CI (no external service may gate a
# build), and previews before the Vercel env is wired. Set them in Vercel Project Settings, NOT in
# GitHub Actions — CI never calls either service, by design.

# Upstash Redis — rate limits the ACCESS GATE only (the app's one unauthenticated password oracle).
# Console -> your Redis database -> "REST API". Absent => the gate is unlimited, as it was pre-V1-14a.
UPSTASH_REDIS_REST_URL="https://<name>-<id>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<rest-token>"

# Sentry error reporting. Settings -> Client Keys (DSN). This is the ONLY Sentry var needed:
# source-map upload is deliberately disabled (see next.config.ts), so no auth token / org / project.
SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
