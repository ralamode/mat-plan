{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-local.ts",
    "dev:prod": "echo '\u26a0\ufe0f  dev:prod \u2192 LIVE Neon via .env.local. Writes hit REAL prod data. Use `pnpm dev` for the local sandbox.' && next dev",
