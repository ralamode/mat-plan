    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
