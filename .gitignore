# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
dist/

# env
.env
.env*.local

# vercel
.vercel

# local secrets (recovery/backup codes, etc.) — folder is DOCUMENTED via its
# committed README, but every actual secret file inside is ignored. Never commit
# a real secret here; connection strings live in apps/web/.env.local.
/.local-secrets/*
!/.local-secrets/README.md

# testing
coverage/
playwright-report/
test-results/
# Playwright gate-auth storage state (carries the gate cookie — never commit).
# `**/` PREFIX IS LOAD-BEARING: a pattern containing a mid-path slash is anchored to the directory
# holding this .gitignore, so the old bare `e2e/.auth/` only matched <repo-root>/e2e/.auth/ — NOT
# apps/web/e2e/.auth/, which is where Playwright actually writes it. The rule silently never applied
# and the cookie was committed (V1-12). Rules WITHOUT an internal slash (`.screenshots/`, `.next/`)
# match at any depth, which is why they were never affected.
**/e2e/.auth/

# local scratch (playwright screenshots, etc.)
.screenshots/
.playwright-mcp/

# persistent local-dev embedded-Postgres data dir (`pnpm dev` sandbox — survives
# restarts, wiped by `pnpm db:local:reset`). Ray's play-data; never commit it.
.local-db/

# typescript
*.tsbuildinfo
next-env.d.ts

# turborepo (future)
.turbo

# misc
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# Agent worktrees (transient, created by Claude Code)
.claude/worktrees/
