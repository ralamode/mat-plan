{
  // Mirrors packages/db/tsconfig.json for the same reason it exists: `tsx` strips types without
  // checking them, so a script project that nothing typechecks fails at runtime instead of in CI.
  // The root `typecheck` script runs this alongside apps/web's and db's.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
