{
  "name": "mat-plan",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:prod": "pnpm --filter web dev:prod",
    "db:local:reset": "pnpm --filter web db:local:reset",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "test": "pnpm --filter web test",
    "db:generate": "pnpm --filter @mat-plan/db db:generate",
    "db:migrate": "pnpm --filter @mat-plan/db db:migrate",
    "db:seed": "pnpm --filter @mat-plan/db db:seed",
    "db:verify": "pnpm --filter @mat-plan/db db:verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,css,yml,yaml}": "prettier --write",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter web exec eslint --fix"
  }
}
